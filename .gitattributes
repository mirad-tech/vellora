# Keep Rust sources compatible with rustfmt on Windows checkouts.
*.rs text eol=lf

# Fixtures and goldens are byte-exact inputs: never normalise their line endings.
tests/fixtures/** -text
tests/golden/** -text

# Shell scripts and Linux desktop files must keep LF to run on Linux.
*.sh text eol=lf
*.desktop text eol=lf
installer/linux/icons/*.png binary
