{
  "name": "vellora-editor",
  "productName": "Vellora",
  "version": "2.4.3",
  "private": true,
  "description": "Local-first Markdown reader and source editor built with Tauri 2 and React",
  "author": "Vellora Contributors",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mirad-tech/vellora.git"
  },
  "bugs": {
    "url": "https://github.com/mirad-tech/vellora/issues"
  },
  "homepage": "https://github.com/mirad-tech/vellora#readme",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "tauri dev",
    "dev:mac": "node mac/scripts/build.mjs --dev",
    "dev:web": "vite",
    "version:check": "node tools/verification/check-version.mjs",
    "build": "npm run typecheck && tauri build --bundles nsis",
    "build:mac": "node mac/scripts/build.mjs",
    "build:web": "vite build",
    "release:organize": "node tools/release/manage-release-artifacts.mjs",
    "release:check": "node tools/release/manage-release-artifacts.mjs --check",
    "release:check:mac": "node mac/scripts/verify.mjs",
    "release:prune-old": "node tools/release/manage-release-artifacts.mjs --prune-old",
    "release:clean-cache": "cargo clean --release --manifest-path src-tauri/Cargo.toml",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:e2e:prepare": "npm ci --prefix tests/e2e/tooling",
    "test:e2e": "node tests/e2e/smoke.mjs",
    "test:e2e:ci": "node tests/e2e/smoke.mjs",
    "test:e2e:desktop": "node tests/e2e/run-desktop.mjs",
    "test:ui:capture": "node tools/verification/capture-ui-review.mjs",
    "tools:msedgedriver": "node tools/webdriver/fetch-msedgedriver.mjs",
    "tauri": "tauri",
    "dist": "npm run build && npm run release:organize",
    "dist:mac": "npm run build:mac && node mac/scripts/organize.mjs && npm run release:check:mac",
    "generate:icon": "node tools/icons/generate-icon.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.5.0",
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-code": "3.31.3",
    "@tiptap/extension-code-block": "3.31.3",
    "@tiptap/extension-image": "3.31.3",
    "@tiptap/extension-link": "3.31.3",
    "@tiptap/extension-paragraph": "3.31.3",
    "@tiptap/extension-table": "3.31.3",
    "@tiptap/markdown": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "dompurify": "^3.4.17",
    "highlight.js": "^11.11.1",
    "markdown-it": "^14.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.5.0",
    "@testing-library/react": "^16.3.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "20.19.43",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "0.28.1",
    "jsdom": "^30.0.1",
    "typescript": "^5.9.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
